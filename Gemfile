source "https://rubygems.org"

# Huom: GitHub Pagesin oletusjulkaisu ("Deploy from a branch") EI käytä tätä Gemfileä
# ollenkaan - GitHub build\u00e4aa palvelimellaan omalla, valmiiksi yhteensopivalla
# gem-ympäristöllään. Tämä Gemfile on olemassa vain paikallista esikatselua varten
# (bundle exec jekyll serve), joten versiot on valittu paikallisen toimivuuden, ei
# GitHub Pages -yhteensopivuuden perusteella.
gem "jekyll", "~> 4.3"

# Tarvitaan remote_theme-teeman (just-the-docs) lataamiseen
gem "jekyll-remote-theme"
gem "jekyll-include-cache"
gem "jekyll-seo-tag"

# Windows/macOS-yhteensopivuus
gem "webrick"

# Uudemmilla Rubyilla (3.4+) nämä eivät enää ole oletuksena mukana
gem "base64"
gem "bigdecimal"
gem "csv"
gem "rexml"
