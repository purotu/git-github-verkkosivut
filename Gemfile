source "https://rubygems.org"

# GitHub Pages -yhteensopiva gem-nippu (sisältää Jekyllin oikean version)
gem "github-pages", group: :jekyll_plugins

# Tarvitaan remote_theme-teeman (just-the-docs) lataamiseen
gem "jekyll-remote-theme"
gem "jekyll-include-cache"

# Windows/macOS-yhteensopivuus
gem "webrick"

# Uudemmilla Rubyilla (3.4+) nämä eivät enää ole oletuksena mukana
gem "base64"
gem "bigdecimal"
gem "csv"
gem "rexml"
